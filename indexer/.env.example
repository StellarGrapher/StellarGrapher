# Postgres connection string
DATABASE_URL=postgresql://prism:prism@localhost:5432/prism

# Soroban RPC endpoint to poll. Required — no silent testnet fallback in production.
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Optional: comma-separated fallback RPC endpoints. The indexer rotates to the next
# endpoint after SOROBAN_RPC_FAILOVER_THRESHOLD consecutive failures and returns to
# the primary once it recovers. The first entry is treated as the primary.
# SOROBAN_RPC_URLS=https://soroban-testnet.stellar.org,https://rpc-fallback.example.org

# Consecutive failures before failing over to the next RPC endpoint. Must be a positive integer.
SOROBAN_RPC_FAILOVER_THRESHOLD=3

# How often to poll for new ledgers, in milliseconds. Must be a positive integer.
POLL_INTERVAL_MS=5000

# Port for the health (/healthz) and metrics (/metrics) HTTP endpoints.
HEALTH_PORT=8080

# Unhealthy when the indexer cursor trails the network by more than this many ledgers.
HEALTH_MAX_LEDGER_LAG=60

# Optional: first ledger to index on a fresh database. Must fall inside the RPC node's
# retention window. Ignored once the indexer has a cursor. Unset: start from the latest ledger.
# INDEXER_START_LEDGER=

# Optional: data retention window in days. Events and invocations older than this are
# deleted by a daily pruning task. Contracts are permanent and never pruned.
# Unset: unlimited retention (nothing is pruned).
# INDEXER_RETENTION_DAYS=30
