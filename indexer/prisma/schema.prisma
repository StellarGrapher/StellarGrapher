generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Singleton row (id always 1) tracking how far the indexer has processed.
// Forward-only: on first run this is seeded to the current latest ledger
// (or just before INDEXER_START_LEDGER), not backfilled from history.
model IndexerCursor {
  id               Int      @id @default(1)
  lastLedger       Int
  paginationCursor String?
  updatedAt        DateTime @updatedAt
}

// A ledger range the live indexer skipped without indexing, and why. Gaps
// apply to every contract, so they are not keyed by contract.
model IndexerGap {
  id         String   @id @default(cuid())
  fromLedger Int
  toLedger   Int
  reason     String
  createdAt  DateTime @default(now())

  @@index([fromLedger])
}

// A transaction the indexer could not decode or persist. Kept instead of being
// silently skipped so it can be inspected and retried from the admin endpoint.
model DeadLetterEvent {
  id           String    @id @default(cuid())
  txHash       String
  ledger       Int
  stage        String // decode | persist
  errorMessage String
  envelopeXdr  String
  resultMetaXdr String
  createdAt    DateTime  @default(now())
  retryCount   Int       @default(0)
  lastRetryAt  DateTime?
  resolvedAt   DateTime?

  @@unique([txHash, stage])
  @@index([resolvedAt, createdAt])
}

model BackfillCursor {
  id               Int      @id @default(1)
  fromLedger       Int
  toLedger         Int
  lastLedger       Int
  paginationCursor String?
  completed        Boolean  @default(false)
  updatedAt        DateTime @updatedAt
}

model Invocation {
  id            String   @id @default(cuid())
  txHash        String
  ledger        Int
  createdAt     DateTime
  contractId    String
  functionName  String
  args          Json
  successful    Boolean
  sourceAccount String
  returnValue   String?
  // Base64 envelope XDR the decoded columns above were derived from, so they
  // can be re-decoded after a decoder change without re-fetching from RPC.
  rawXdr        String?

  @@unique([txHash])
  @@index([contractId, ledger])
}

model Contract {
  contractId       String   @id
  creator          String
  // Account that signed the deploying invokeHostFunction operation (the
  // operation source, or the transaction source when it inherits one).
  deployerAccountId String?
  deploymentLedger Int
  deploymentTxHash String   @unique
  createdAt        DateTime
  // Ledger at which the contract instance entry expires (from getLedgerEntries
  // liveUntilLedgerSeq). Null until observed or when the entry has no TTL.
  expiresAtLedger  Int?

  @@index([creator])
  @@index([deployerAccountId])
}

// One row per observed change to a contract storage entry (not just the
// latest value) — an append-only log. "Current value" for a key is its
// most recent non-removed row. This is what makes full key enumeration
// possible for contracts touched since the indexer started, which plain
// RPC access can't do at all.
model StorageChange {
  id           String   @id @default(cuid())
  contractId   String
  durability   String // persistent | temporary | instance
  changeIndex  Int // position of the change within the transaction's meta
  keyDisplay   String // human-readable decoded key ("__instance__" for the contract instance entry)
  valueDisplay String? // human-readable decoded value; null when changeType is "removed"
  changeType   String // created | updated | removed | state
  ledger       Int
  txHash       String
  createdAt    DateTime

  // Keyed by position, not by decoded content: a transaction can touch the same
  // key twice (state then updated), and reprocessing it after a restart must
  // map onto the same rows so skipDuplicates can ignore them.
  @@unique([txHash, changeIndex])
  @@index([contractId, keyDisplay, durability, ledger])
  @@index([contractId, ledger])
}

// Per-invocation before/after view of a contract storage entry, derived from
// the transaction meta's ledgerEntryState (before) and created/updated/removed
// (after) changes. Unlike StorageChange this is keyed by invocation, so a
// caller can answer "what did this call change?" directly.
model InvocationStorageChange {
  id           String   @id @default(cuid())
  invocationId String
  contractId   String
  durability   String // persistent | temporary | instance
  key          String // human-readable decoded key ("__instance__" for the contract instance entry)
  valueBefore  String? // decoded value before the invocation; null when the key did not exist
  valueAfter   String? // decoded value after the invocation; null when the key was removed
  ledger       Int
  txHash       String
  createdAt    DateTime

  @@unique([invocationId, key, durability])
  @@index([invocationId])
  @@index([contractId, ledger])
}

model ContractEventRecord {
  id         String   @id @default(cuid())
  eventId    String   @unique
  contractId String
  type       String
  topic      Json
  value      String
  // Set only for `contract_created` events.
  deployer   String?
  salt       String?
  wasmHash   String?
  txHash     String
  ledger     Int
  eventIndex Int
  createdAt  DateTime
  // Base64 ContractEvent XDR the decoded columns above were derived from.
  // Null for synthesized `contract_created` events, which have no XDR.
  rawXdr     String?

  // Full-text search document over the decoded topic and value. Maintained by
  // the ContractEventRecord_search_vector trigger (see the fts migration), so
  // it is never written from application code.
  searchVector Unsupported("tsvector")? @map("search_vector")

  @@index([contractId, ledger, eventIndex])
  @@index([contractId, ledger])
}

// SEP-41 token events (transfer, mint, burn, approve), decoded out of the
// contract events above so an account's token activity is queryable by
// address without scanning every event's topics.
model TokenEvent {
  id              String   @id @default(cuid())
  eventId         String   @unique
  tokenContractId String
  eventType       String // transfer | mint | burn | approve
  from            String? // null for mint
  to              String? // null for burn
  spender         String? // set for approve
  amount          String // decimal string; i128 doesn't fit a JS number
  txHash          String
  ledger          Int
  createdAt       DateTime

  @@index([from, ledger])
  @@index([to, ledger])
  @@index([tokenContractId, ledger])
}
