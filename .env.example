# Maximum accepted size (in bytes) for XDR decoder request bodies.
# Requests larger than this are rejected with HTTP 413.
# Defaults to 1048576 (1 MB) when unset.
XDR_MAX_INPUT_BYTES=1048576

# Maximum number of client entries tracked by the in-memory rate limiter.
# When the cap is reached, the least-recently-used entry is evicted.
# Defaults to 10000 when unset.
RATE_LIMIT_MAX_ENTRIES=10000
